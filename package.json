{
  "name": "whatsapp-gateway-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "src"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev:backend": "cd api && npm run dev",
    "dev:frontend": "cd src && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}